DATABASE_URL=ecto://postgres:postgres@localhost:5433/product_compare_dev
TEST_DATABASE_URL=ecto://postgres:postgres@localhost:5433/product_compare_test
POOL_SIZE=10
PORT=4000

# CJ provider credentials stay local; never commit real values.
CJ_API_TOKEN=
CJ_ACCOUNT_ID=
# Optional comma-separated publisher IDs override CJ_ACCOUNT_ID for commission imports.
CJ_COMMISSION_PUBLISHER_IDS=
CJ_COMMISSION_SYNC_DEFAULT_INTERVAL_MINUTES=1440
CJ_COMMISSION_SYNC_DEFAULT_LOOKBACK_DAYS=90
CJ_COMMISSION_SYNC_DEFAULT_MAX_PAGES=100
