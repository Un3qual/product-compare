{
  "name": "product-compare-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && pnpm run check:bundle",
    "start": "react-router-serve ./dist/server/index.js",
    "check:bundle": "node scripts/check-client-bundle.ts",
    "format:check": "oxfmt --check src test tests scripts '*.ts' '!src/__generated__/**'",
    "lint": "oxlint --deny-warnings --ignore-pattern 'src/__generated__/**' src test tests scripts playwright.config.ts stylex-plugin.ts vite.config.ts vitest.config.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "relay": "relay-compiler",
    "relay:check": "relay-compiler --validate",
    "check": "pnpm run relay:check && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:unit && pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@stylexjs/stylex": "0.18.1",
    "@tanstack/charts": "0.11.1",
    "@tanstack/react-table": "9.1.2",
    "@react-router/serve": "8.3.1",
    "isbot": "5.2.2",
    "lucide-react": "1.11.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-relay": "21.0.1",
    "react-router": "8.3.1",
    "relay-runtime": "21.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@playwright/test": "1.58.2",
    "@react-router/dev": "8.3.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@stylexjs/babel-plugin": "0.18.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.19.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-plugin-relay": "21.0.1",
    "jsdom": "26.1.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "relay-compiler": "21.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.18.0"
  },
  "packageManager": "pnpm@11.18.0"
}
