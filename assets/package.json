{
  "name": "product-compare-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:client && pnpm run build:ssr && pnpm run check:stylex-mangle && pnpm run check:bundle",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry.server.tsx --outDir dist/server",
    "check:bundle": "node scripts/check-client-bundle.ts",
    "check:stylex-mangle": "node scripts/check-stylex-mangle.ts",
    "format:check": "oxfmt --check src test tests scripts plugins '*.ts' '!src/__generated__/**'",
    "lint": "oxlint --deny-warnings --ignore-pattern 'src/__generated__/**' src test tests scripts plugins playwright.config.ts stylex-plugin.ts vite.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "relay": "relay-compiler",
    "relay:check": "relay-compiler --validate",
    "check": "pnpm run relay:check && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:unit && pnpm run build"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-accordion": "1.2.16",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-collapsible": "1.1.16",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-scroll-area": "1.2.14",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/themes": "3.3.0",
    "@stylexjs/stylex": "0.18.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-relay": "20.1.1",
    "react-router-dom": "7.18.2",
    "relay-runtime": "20.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@playwright/test": "1.58.2",
    "@rolldown/plugin-babel": "0.2.3",
    "@stylexjs/babel-plugin": "0.18.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.19.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/relay-runtime": "20.1.1",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-relay": "20.1.1",
    "jsdom": "26.1.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "relay-compiler": "20.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.18.0"
  },
  "packageManager": "pnpm@11.18.0"
}
