{
  "name": "product-compare-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:client && bun run build:ssr && bun run check:bundle",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry.server.tsx --outDir dist/server",
    "check:bundle": "bun scripts/check-client-bundle.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "relay": "relay-compiler",
    "relay:check": "relay-compiler --validate",
    "check": "bun run typecheck && bun run test:unit"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.17",
    "@stylexjs/stylex": "0.18.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-relay": "^20.1.1",
    "react-router-dom": "^7.0.0",
    "relay-runtime": "^20.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@stylexjs/babel-plugin": "^0.18.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/relay-runtime": "^20.1.1",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-plugin-relay": "20.1.1",
    "bun-types": "^1.3.8",
    "jsdom": "^26.1.0",
    "relay-compiler": "^20.1.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.8"
  }
}
